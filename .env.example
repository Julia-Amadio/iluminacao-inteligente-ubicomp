# Obrigatória: connection string do MongoDB (Atlas free tier serve bem).
MONGO_URI=

# Fuso usado para decidir a que DIA um evento pertence (agregações e
# GET /eventos/hoje). Não afeta os timestamps gravados, que seguem em UTC.
# Em Windows nativo o zoneinfo precisa de `pip install tzdata`.
# Default (sem essa variável): America/Sao_Paulo
# TZ_LOCAL=

# Tudo abaixo só importa se for trocar o broker público (HiveMQ,
# broker.hivemq.com) por um broker privado. Hoje os testes rodam no broker
# público via WebSocket, então só MONGO_URI é necessária — deixe comentado
# a menos que esteja apontando pra um broker privado.

# Host do broker MQTT.
# Default (sem essa variável): broker.hivemq.com
# MQTT_BROKER=

# Porta do broker. Brokers privados com TLS tipicamente usam 8883.
# Default (sem essa variável): 1883
# MQTT_PORTA=

# Tópico assinado pelo subscriber.
# Default (sem essa variável): pervasiva/grupo1/iluminacao
# MQTT_TOPICO=

# Tópico onde POST /comando publica os comandos manuais. O ESP32 assina este
# tópico, e o frontend publica nele direto por WebSocket — se mudar aqui, mude
# também no firmware e no VITE_MQTT_CONTROL_TOPIC do frontend.
# Default (sem essa variável): pervasiva/grupo1/iluminacao/controle
# MQTT_TOPICO_CONTROLE=

# Só necessárias se o broker privado exigir autenticação. Quando as duas
# estiverem presentes, o client MQTT também habilita TLS (tls_set()).
# MQTT_USER=
# MQTT_PASSWORD=

# Duração do override manual, em segundos. Se mudar aqui, mude também no
# firmware do ESP32 (docs/codigo_esp32.py) — o timer real roda lá, o backend
# só reproduz a contagem para informar o modo atual em GET /estado.
# Default no código HOJE: 10 (valor temporário de teste; ver comentário em
# backend/config.py). Valor pretendido para a entrega: 300 (5 minutos).
# OVERRIDE_MANUAL_SEGUNDOS=
